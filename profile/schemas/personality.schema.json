{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portfolio/personality.schema.json",
  "title": "Profile personality",
  "description": "Reviewed AI interpretation. Distinguishes verified observations, provisional AI interpretations, and approved final characteristics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifiedObservations", "provisionalInterpretations", "approvedCharacteristics", "communicationStyle", "learningAttitude", "interests", "values", "motivations", "aboutText", "aboutGuidance"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verifiedObservations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provisionalInterpretations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "approvedCharacteristics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] }
        }
      }
    },
    "communicationStyle": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] }
        }
      }
    },
    "learningAttitude": { "type": ["string", "null"] },
    "interests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] }
        }
      }
    },
    "motivations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "aboutText": { "type": ["string", "null"], "description": "Approved About section text (150-200 words)." },
    "aboutGuidance": { "type": ["string", "null"], "description": "Guidance for writing or regenerating the About section." }
  }
}
