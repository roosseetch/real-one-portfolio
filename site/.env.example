# Public browser ingestion key for Amplitude project 848758 (real-one-portfolio).
# Set the real value only in a local/deployment environment; never use a Secret Key here.
VITE_AMPLITUDE_API_KEY=
# Optional fallback used only when a direct request to Amplitude is blocked.
VITE_AMPLITUDE_SERVER_URL=
# Worker origin the contact form posts to, e.g. https://worker.example.com.
VITE_WORKER_BASE_URL=
# Public Turnstile site key. The secret half is a Worker secret, never here:
# everything in this file is inlined into the bundle every visitor downloads.
VITE_TURNSTILE_SITE_KEY=
