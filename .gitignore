# Personalized / secret files — never tracked (reusable-repo rule)
*.auto.tfvars
backend.private.hcl
worker/.dev.vars
worker/.env
worker/wrangler.generated.json
site/.env
site/.env.*
!site/.env.example

# Local credential files at any level
.env
.env.*
!.env.example
.envrc

# Terraform local state (bootstrap stack).
# The trailing glob matters: `terraform state rm` and `state mv` write
# terraform.tfstate.<epoch>.backup, which the exact names below do not catch,
# and any state file names every bucket, domain and account id in the account.
terraform.tfstate*
**/terraform.tfstate*
.terraform/
**/.terraform/
.terraform.lock.hcl.backup

# Private source material (raw CV, photos, reflections), including the full
# profile that scripts/publish-profile.ts strips before publishing.
private-inputs/

# The approved profile is one person's name, role and history, so it does not
# belong in a repository meant to be reused for someone else (spec §1). It is
# published to the public content bucket and fetched at build time by
# scripts/fetch-profile.ts. The schemas stay tracked: they describe the shape,
# not the person.
profile/*.json

# Build + deps
node_modules/
dist/
.wrangler/
__pycache__/
*.pyc
.pytest_cache/

# Editor / OS noise
.DS_Store
*.log
