# Copy to worker/.env (gitignored). These are the non-secret deployment names
# that generate-wrangler.ts renders into wrangler.generated.json.
#
#   set -a; . ./worker/.env; set +a; npm --prefix worker run config

WORKER_NAME=
PRIVATE_BUCKET=
CONTENT_BUCKET=
CONTENT_BASE_URL=
MEDIA_BASE_URL=
GITHUB_REPOSITORY=
