# Copy to worker/.env (gitignored). These are the non-secret deployment names
# used by the scripts in scripts/ — generate-wrangler.ts renders most of them
# into wrangler.generated.json.
#
#   set -a; . ./worker/.env; set +a; npm --prefix worker run config

WORKER_NAME=
PRIVATE_BUCKET=
CONTENT_BUCKET=
# Bound only so a cancelled confirmation can remove derivatives GitHub Actions
# had already uploaded. Nothing in the Worker writes to it.
MEDIA_BUCKET=
CONTENT_BASE_URL=
MEDIA_BASE_URL=
GITHUB_REPOSITORY=

# Public browser ingestion key. The fallback relay accepts only payloads for
# this project.
AMPLITUDE_API_KEY=

# Public URL of the published site, origin only. The Worker sends the author a
# link here after publishing.
SITE_BASE_URL=

# Public base URL of the deployed Worker, origin only — the webhook path is a
# constant in set-telegram-webhook.ts so it cannot drift from the router.
# Terraform's worker_hostname output has the value; before the custom domain is
# enabled, the workers.dev URL works too.
WORKER_BASE_URL=
