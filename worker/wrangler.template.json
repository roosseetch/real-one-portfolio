{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "__WORKER_NAME__",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_BUCKET",
      "bucket_name": "__PRIVATE_BUCKET__"
    },
    {
      "binding": "CONTENT_BUCKET",
      "bucket_name": "__CONTENT_BUCKET__"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "CONTENT_BASE_URL": "__CONTENT_BASE_URL__",
    "MEDIA_BASE_URL": "__MEDIA_BASE_URL__",
    "GITHUB_REPOSITORY": "__GITHUB_REPOSITORY__",
    "MEDIA_WORKFLOW_FILE": "__MEDIA_WORKFLOW_FILE__"
  }
}
