# Copy to worker/.dev.vars (gitignored) for local `wrangler dev`.
# In production these are Worker secrets, set with `wrangler secret put NAME`
# or by the deploy-worker workflow from GitHub secrets. They never appear in
# wrangler.template.json or any tracked file.

# From BotFather.
TELEGRAM_BOT_TOKEN=

# Random string, also given to Telegram when registering the webhook. Telegram
# echoes it back in X-Telegram-Bot-Api-Secret-Token on every request.
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated numeric Telegram user IDs allowed to author content.
TELEGRAM_ALLOWED_USER_IDS=

# Fine-grained GitHub token with actions:write on this repository only, used to
# dispatch the media processing workflow. Stored as the repository secret
# WORKER_DISPATCH_TOKEN, because GitHub refuses to store a secret whose name
# begins with GITHUB_.
GITHUB_DISPATCH_TOKEN=

# Shared secret the media workflow signs its callback with. Must match the
# CALLBACK_HMAC_SECRET GitHub secret exactly.
CALLBACK_HMAC_SECRET=

# Secret half of the LinkedIn app, from https://www.linkedin.com/developers/apps
# -> Auth. Used only to exchange an authorization code for a member token and to
# refresh one. The member token itself is not configured anywhere: it expires
# every sixty days, and the Worker writes each new one into the private bucket
# after the author logs in. Leave this empty and the Repost button says LinkedIn
# is not set up.
LINKEDIN_CLIENT_SECRET=
